{
  "appId": "com.csr.generator.desktop",
  "productName": "CSR Generator",
  "directories": {
    "output": "dist"
  },
  "files": [
    "assets/**/*",
    "backup/**/*",
    "db/**/*",
    "downloads/**/*",
    "libraries/**/*",
    "main/**/*",
    "launcher/**/*",
    "node_modules/playwright-core/**/*",
    "runtime/**/*",
    "start-app.bat",
    "stop-app.bat",
    "run-server.bat"
  ],
  "asar": false,
  "win": {
    "signAndEditExecutable": false,
    "icon": "assets/logo.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "installerIcon": "assets/logo.ico",
    "uninstallerIcon": "assets/logo.ico"
  }
}
